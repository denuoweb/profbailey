{
  "lifecycle": {
    "rule": [
      {
        "action": {
          "type": "SetStorageClass",
          "storageClass": "ARCHIVE"
        },
        "condition": {
          "age": 1,
          "matchesStorageClass": [
            "STANDARD",
            "REGIONAL",
            "NEARLINE",
            "COLDLINE"
          ]
        }
      }
    ]
  }
}
