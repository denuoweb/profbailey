{
  "hosting": {
    "site": "profbailey",
    "public": "hosting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/glman",
        "destination": "/glman/index.html",
        "type": 301
      },
      {
        "source": "/gamemaker",
        "destination": "/gamemaker/index.html",
        "type": 301
      },
      {
        "source": "/cgeducation/ShadersBookSecond",
        "destination": "/cgeducation/ShadersBookSecond/index.html",
        "type": 301
      },
      {
        "source": "/cs519",
        "destination": "/cs519/index.html",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://storage.googleapis.com https://i.creativecommons.org data:; font-src 'self'; media-src 'self' https://storage.googleapis.com; frame-src 'self' https://blocks.glass; child-src 'self' https://blocks.glass; connect-src 'self'; form-action 'none'; frame-ancestors 'none'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive"
          },
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600"
          }
        ]
      },
      {
        "source": "**/*.@(avif|bmp|gif|ico|jpeg|jpg|png|svg|webp|woff|woff2|ttf|otf|pdf|zip|tar|gz|mp4|mkv|avi|wmv|obj|blend|csv|data|exe|dll|lib)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
