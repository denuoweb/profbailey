{
  "hosting": {
    "site": "profbailey",
    "public": "hosting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/glman",
        "destination": "/glman/index.html",
        "type": 301
      },
      {
        "source": "/gamemaker",
        "destination": "/gamemaker/index.html",
        "type": 301
      },
      {
        "source": "/cgeducation/ShadersBookSecond",
        "destination": "/cgeducation/ShadersBookSecond/index.html",
        "type": 301
      },
      {
        "source": "/cs519",
        "destination": "/cs519/index.html",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
